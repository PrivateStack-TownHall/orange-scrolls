PORT=
DATABASE_URL=
PWD_SUPABASE=your_database_password
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_service_role_key

# Cloudinary (used for media/image uploads via the /media/upload endpoint)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional — defaults to "orange-scrolls" if not set
CLOUDINARY_FOLDER=orange-scrolls

# CORS — comma separated list of allowed browser origins, e.g.
#   CORS_ORIGIN=https://cms.example.com,https://admin.example.com
# If unset: localhost origins only outside production, and CORS disabled
# when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5175
